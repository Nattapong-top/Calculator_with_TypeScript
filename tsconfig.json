{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    "outDir": "./dist", // ส่งไฟล์ที่คอมไพล์แล้วไปไว้ที่โฟลเดอร์ dist แยกต่างหาก
    "rootDir": "./", // กำหนด Root ของโปรเจกต์
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}